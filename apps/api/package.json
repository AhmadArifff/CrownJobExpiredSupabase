{
  "name": "@cronjob/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm --prefix ../../packages/shared run build && node -e \"const fs=require('fs'); fs.rmSync('node_modules/@cronjob/shared', {recursive:true, force:true}); fs.cpSync('../../packages/shared', 'node_modules/@cronjob/shared', {recursive:true});\" && npx prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@cronjob/shared": "file:../../packages/shared",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.48.1",
    "better-auth": "^1.1.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
